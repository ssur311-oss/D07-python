# 이 파일을 복사해서 .env로 만들고 실제 키를 넣으세요. (.env는 git에 올라가지 않습니다)
# 키 발급: https://home.openweathermap.org/api_keys (발급 직후엔 활성화에 몇 시간 걸릴 수 있음)
OPENWEATHER_API_KEY=여기에_발급받은_키를_입력
# 환율 계산기(ratecalc.py) - https://www.exchangerate-api.com 에서 무료 키 발급
EXCHANGERATE_API_KEY=여기에_발급받은_키를_입력
# 챗봇(chat.py) - https://console.anthropic.com 에서 키 발급
ANTHROPIC_API_KEY=여기에_발급받은_키를_입력
